# Aura & Vow - Environment Variables Reference
# Copy this file to .env for local overrides if needed.
# NEVER commit the actual .env file with production secrets to Git!

# Server port (default: 5000)
PORT=5000

# Flask debug mode: 0 for Production, 1 for Development
FLASK_DEBUG=0

# Secret key for session security & token generation
SECRET_KEY=change-this-to-a-random-hex-in-production

# Custom database storage path (optional, default: backend/wedding_planner.db)
# DATABASE_PATH=/var/data/wedding_planner.db
